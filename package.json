{
  "name": "react-til",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node scripts/check-node-version.cjs && vite",
    "verify:app-imports": "node scripts/verify-app-imports.cjs",
    "build": "node scripts/check-node-version.cjs && npm run verify:app-imports && vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "node scripts/run-vitest-if-node18.cjs",
    "test:watch": "node scripts/check-node-version.cjs && vitest",
    "preview": "node scripts/check-node-version.cjs && vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.22.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^8.57.0",
    "vite": "^8.0.6",
    "vitest": "^3.2.4"
  }
}
